---
interface Props {
    departments: string[];
    locations: string[];
}

const { departments, locations } = Astro.props;
const groups = [
    { name: 'department', legend: 'Department', options: departments },
    { name: 'location', legend: 'Location', options: locations },
];
---

<form
    data-testid="role-filters"
    class="mb-8 rounded-xl border border-slate-700 bg-slate-800/50 p-5"
    aria-label="Filter roles"
>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
            groups.map((group) => (
                <fieldset data-testid={`${group.name}-filter`}>
                    <legend class="mb-2 text-sm font-semibold text-slate-100">{group.legend}</legend>
                    <div class="max-h-48 space-y-1 overflow-y-auto pr-2">
                        {group.options.map((option) => (
                            <label class="flex items-center gap-2 text-sm text-slate-300">
                                <input
                                    type="checkbox"
                                    name={group.name}
                                    value={option}
                                    data-testid={`${group.name}-option`}
                                    class="h-4 w-4 rounded border-slate-500 bg-slate-900 accent-[#2E6CFC] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2E6CFC]"
                                />
                                {option}
                            </label>
                        ))}
                    </div>
                </fieldset>
            ))
        }
    </div>
    <div class="mt-5 flex flex-wrap items-center gap-4">
        <button
            type="reset"
            data-testid="filter-reset"
            class="rounded-lg border border-slate-500 px-4 py-2 text-sm font-medium text-slate-100 hover:border-[#2E6CFC] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2E6CFC]"
        >
            Reset filters
        </button>
        <p class="text-sm text-slate-300" role="status" data-testid="filter-count"></p>
    </div>
</form>
